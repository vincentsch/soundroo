{
  "name": "soundroo",
  "version": "0.7.0",
  "description": "Original music made with your coding agent. A local composition toolkit and listening studio.",
  "private": true,
  "type": "module",
  "bin": {
    "soundroo": "bin/soundroo.js"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "scripts": {
    "start": "node bin/soundroo.js start",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "web/",
    "assets/",
    "examples/",
    "docs/",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "author": "Vincent Schmalbach",
  "license": "MIT",
  "repository": "github:vincentsch/soundroo",
  "keywords": [
    "music",
    "audio",
    "composition",
    "synthesis",
    "sound-design",
    "claude-code",
    "codex",
    "creative-coding",
    "local-first"
  ]
}
